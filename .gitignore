# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Environments and tool caches
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets: the API key is read from the environment and must never reach a commit.
.env
.env.*
*.key

# Editors / OS
.DS_Store

# Markdown: only README.md is tracked; ticket, plan and ADR docs stay local.
*.md
!README.md

# Note: uv.lock is committed on purpose (reproducible environment).
